#!/usr/bin/env bash
# Install llm-manager from a checked-out source folder, inside the container, and roll back if it
# doesn't come up. Installed as /usr/local/sbin/llm-manager-deploy (root:root 755). The CI runner
# user may run only this, via sudo (ci/setup-runner.sh); it never gets a root shell.
#
#   llm-manager-deploy <source dir>
#
# Touches only the app code (/opt/llm-manager/*.py, web/) and the CLI. Never the env file, the state
# dir (password, sessions, HF token, jobs), the systemd unit or the models share.
set -euo pipefail
umask 022
[[ $(id -u) == 0 ]] || { echo "run as root" >&2; exit 1; }
SRC=$(realpath -e "${1:?usage: llm-manager-deploy <source dir>}")
APP=/opt/llm-manager
PY=$APP/venv/bin/python
FILES=(server.py downloader.py hfinfo.py quants.py auth.py transfer.py web/index.html web/login.html)
PORT=$(sed -n 's/^PORT=//p' /etc/llm-manager/env 2>/dev/null | tail -1); PORT=${PORT:-8080}

for f in "${FILES[@]}" llm-manager requirements.txt; do
  [[ -f $SRC/$f && ! -L $SRC/$f ]] || { echo "missing or symlinked: $f" >&2; exit 1; }
done

STAGE=$(mktemp -d "$APP/.stage.XXXXXX"); trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE/web"
for f in "${FILES[@]}" llm-manager requirements.txt; do install -m 644 "$SRC/$f" "$STAGE/$f"; done
# compile check only: nothing from the new code runs as root
"$PY" - "$STAGE" <<'PYEOF'
import sys, pathlib
for p in pathlib.Path(sys.argv[1]).glob("*.py"):
    compile(p.read_bytes(), str(p), "exec")  # syntax check in memory; writes no .pyc
PYEOF

# dependencies: wheels only, so no package build script runs as root
if ! cmp -s "$STAGE/requirements.txt" "$APP/requirements.txt"; then
  echo "==> requirements changed"
  "$PY" -m pip install -q --only-binary :all: -r "$STAGE/requirements.txt"
fi

echo "==> backing up the running version"
rm -rf "$APP/.prev"; mkdir -p "$APP/.prev/web"
for f in "${FILES[@]}" requirements.txt; do [[ -f $APP/$f ]] && cp -p "$APP/$f" "$APP/.prev/$f"; done
cp -p /usr/local/bin/llm-manager "$APP/.prev/llm-manager" 2>/dev/null || true

install_from() {
  local d=$1
  mkdir -p "$APP/web"
  for f in "${FILES[@]}" requirements.txt; do [[ -f $d/$f ]] && install -m 644 "$d/$f" "$APP/$f"; done
  [[ -f $d/llm-manager ]] && install -m 755 "$d/llm-manager" /usr/local/bin/llm-manager
  return 0
}
healthy() {
  for _ in $(seq 1 20); do
    sleep 1
    systemctl is-active -q llm-manager || continue
    code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:$PORT/login" || true)
    [[ $code == 200 ]] && return 0
  done
  return 1
}

echo "==> installing $(cat "$SRC/.release" 2>/dev/null || echo 'new version')"
install_from "$STAGE"
# a restart pauses a running download; it resumes from its partial files
systemctl restart llm-manager
if healthy; then
  echo "==> llm-manager is up on :$PORT"
  [[ -f $SRC/.release ]] && install -m 644 "$SRC/.release" "$APP/.release"
  exit 0
fi
echo "!!  new version did not come up; rolling back" >&2
journalctl -u llm-manager -n 30 --no-pager -o cat >&2 || true
install_from "$APP/.prev"
systemctl restart llm-manager
healthy && echo "==> rolled back; previous version is running" >&2 || echo "!!  rollback is not healthy either" >&2
exit 1
